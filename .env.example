# Variáveis de ambiente de PRODUÇÃO (ver src/main/resources/application-prod.properties)

# Banco de dados (MySQL)
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=saudeConecta
MYSQLUSER=seu_usuario
MYSQLPASSWORD=sua_senha_segura

# JWT — gere com: openssl rand -base64 64
JWT_SECRET=sua_chave_secreta_forte

# E-mail (Gmail com App Password)
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_app_password

# Mercado Pago (MP_BACK_URL precisa ser uma URL pública)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_BACK_URL=

# Opcionais
# Porta do container: o Dockerfile usa PORT (-Dserver.port), que tem prioridade sobre SERVER_PORT
PORT=8080
CORS_ALLOWED_ORIGINS=https://saude-conecta-frontend.vercel.app
HTTP_CONNECT_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
