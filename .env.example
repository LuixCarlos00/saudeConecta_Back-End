# ===========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ===========================================
DB_URL=jdbc:mysql://localhost:3306/saudeConecta
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha_segura

# ===========================================
# CONFIGURAÇÕES DE SEGURANÇA JWT
# ===========================================
# IMPORTANTE: Use uma chave forte de pelo menos 256 bits
# Gere uma chave segura com: openssl rand -base64 32
JWT_SECRET=sua_chave_secreta_muito_forte_aqui_minimo_32_caracteres

# ===========================================
# CONFIGURAÇÕES DE EMAIL (Gmail)
# ===========================================
# Para usar Gmail, habilite "App Passwords" em:
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_app_password

# ===========================================
# CONFIGURAÇÕES DO TWILIO (SMS)
# ===========================================
# Obtenha suas credenciais em: https://console.twilio.com
TWILIO_ACCOUNT_SID=seu_account_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_PHONE_NUMBER=seu_numero_twilio

# ===========================================
# URLs DA APLICAÇÃO
# ===========================================
URL_BACKEND=http://localhost:8080
URL_FRONTEND=http://localhost:4200

# ===========================================
# CONFIGURAÇÕES PIX ESTÁTICO (chave do recebedor)
# ===========================================
# Chave Pix do recebedor (CPF, CNPJ, email, telefone ou aleatória)
PIX_CHAVE=seu_cpf_ou_chave_pix
# Nome do recebedor (max 25 chars, sem acentos)
PIX_NOME=SAUDE CONECTA
# Cidade do recebedor (max 15 chars, sem acentos)
PIX_CIDADE=SAO PAULO
