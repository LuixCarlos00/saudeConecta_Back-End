<component name="InspectionProjectProfileManager">
  <profile version="1.0">
    <option name="myName" value="Project Default" />
    <inspection_tool class="JvmLinesOfCodeInspection" enabled="true" level="WARNING" enabled_by_default="true" />
    
    <!-- JavaDoc para APIs públicas -->
    <inspection_tool class="JavaDoc" enabled="true" level="WARNING" enabled_by_default="true">
      <option name="REQUIRE_JAVADOC_FOR_PUBLIC_API" value="true" />
      <option name="TOP_LEVEL_CLASS_OPTIONS">
        <value>
          <option name="JAVADOC_REQUIRED_FOR_PUBLIC_CLASS" value="true" />
        </value>
      </option>
      <option name="INNER_CLASS_OPTIONS">
        <value>
          <option name="JAVADOC_REQUIRED_FOR_PUBLIC_CLASS" value="true" />
        </value>
      </option>
      <option name="METHOD_OPTIONS">
        <value>
          <option name="JAVADOC_REQUIRED_FOR_PUBLIC_METHOD" value="true" />
        </value>
      </option>
    </inspection_tool>

    <!-- Detecta código não utilizado -->
    <inspection_tool class="UnusedDeclaration" enabled="true" level="WARNING" enabled_by_default="true" />

    <!-- Strings hardcoded (exceto SQL) -->
<!--    <inspection_tool class="HardCodedStringLiteral" enabled="true" level="WARNING" enabled_by_default="true">-->
<!--      <option name="IGNORE_SQL_STATEMENTS" value="true" />-->
<!--      <option name="IGNORE_PROPERTY_KEYS" value="true" />-->
<!--    </inspection_tool>-->

    <!-- Verificação de ortografia -->
    <inspection_tool class="SpellCheckingInspection" enabled="true" level="TYPO" enabled_by_default="true">
      <option name="processCode" value="true" />
      <option name="processLiterals" value="true" />
    </inspection_tool>

    <!-- Métodos muito longos -->
    <inspection_tool class="MethodOverlyLong" enabled="true" level="WARNING" enabled_by_default="true">
      <option name="m_limit" value="30" />
    </inspection_tool>

    <!-- Classes muito longas -->
    <inspection_tool class="ClassOverlyLong" enabled="true" level="WARNING" enabled_by_default="true">
      <option name="m_limit" value="300" />
    </inspection_tool>

    <!-- Spring específico -->
    <inspection_tool class="SpringBootApplicationProperties" enabled="true" level="WARNING" enabled_by_default="true" />
    <inspection_tool class="SpringBootApplicationSetup" enabled="true" level="WARNING" enabled_by_default="true" />
    
    <!-- JPA/Hibernate -->
    <inspection_tool class="JpaQlInspection" enabled="true" level="ERROR" enabled_by_default="true" />
    <inspection_tool class="JpaEntityListenerInspection" enabled="true" level="WARNING" enabled_by_default="true" />
    
    <!-- Potenciais bugs -->
    <inspection_tool class="NullPointerException" enabled="true" level="WARNING" enabled_by_default="true" />
    <inspection_tool class="Resource Leak" enabled="true" level="WARNING" enabled_by_default="true" />
    
    <!-- Performance -->
    <inspection_tool class="StringBufferReplaceableByString" enabled="true" level="WARNING" enabled_by_default="true" />
    <inspection_tool class="CollectionAddAllCanBeReplacedWithConstructor" enabled="true" level="WARNING" enabled_by_default="true" />
    
    <!-- Convenções Java -->
    <inspection_tool class="NamingConvention" enabled="true" level="WARNING" enabled_by_default="true" />
    <inspection_tool class="FieldCanBeLocal" enabled="true" level="WARNING" enabled_by_default="true" />
  </profile>
</component>