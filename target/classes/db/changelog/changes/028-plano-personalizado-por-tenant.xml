<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ========================================== -->
    <!-- PLANO_ASSINATURA: preço por perfil adicional -->
    <!-- ========================================== -->
    <changeSet id="028-001-adicionar-valor-adicional-plano" author="equipe-sentinela">
        <addColumn tableName="plano_assinatura">
            <column name="valor_adicional_admin" type="DECIMAL(10,2)" defaultValueNumeric="0.00">
                <constraints nullable="true"/>
            </column>
            <column name="valor_adicional_profissional" type="DECIMAL(10,2)" defaultValueNumeric="0.00">
                <constraints nullable="true"/>
            </column>
            <column name="valor_adicional_secretaria" type="DECIMAL(10,2)" defaultValueNumeric="0.00">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- ========================================== -->
    <!-- ASSINATURA_TENANT: limites customizados    -->
    <!-- por tenant + valor adicional de perfis     -->
    <!-- ========================================== -->
    <changeSet id="028-002-adicionar-limites-custom-assinatura" author="equipe-sentinela">
        <addColumn tableName="assinatura_tenant">
            <column name="limite_admin_org_custom" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="limite_profissional_custom" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="limite_secretaria_custom" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="qtd_admin_extra" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="qtd_profissional_extra" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="qtd_secretaria_extra" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="valor_adicional_perfis" type="DECIMAL(10,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- ========================================== -->
    <!-- Atualizar plano Business: limites concretos -->
    <!-- e preços por perfil adicional               -->
    <!-- ========================================== -->
    <changeSet id="028-003-atualizar-plano-business" author="equipe-sentinela">
        <update tableName="plano_assinatura">
            <column name="limite_profissional" valueNumeric="20"/>
            <column name="limite_secretaria" valueNumeric="20"/>
            <column name="valor_adicional_admin" valueNumeric="59.00"/>
            <column name="valor_adicional_profissional" valueNumeric="39.00"/>
            <column name="valor_adicional_secretaria" valueNumeric="29.00"/>
            <where>tipo = 'BUSINESS'</where>
        </update>
    </changeSet>

    <!-- Preços adicionais para os outros planos -->
    <changeSet id="028-004-atualizar-valores-adicionais-outros-planos" author="equipe-sentinela">
        <update tableName="plano_assinatura">
            <column name="valor_adicional_admin" valueNumeric="59.00"/>
            <column name="valor_adicional_profissional" valueNumeric="39.00"/>
            <column name="valor_adicional_secretaria" valueNumeric="29.00"/>
            <where>tipo IN ('STARTER', 'PROFISSIONAL')</where>
        </update>
    </changeSet>

</databaseChangeLog>
