<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="039-indice-configuracao-grafico-dashboard" author="sentinela">
        <!--
            Covering index para o endpoint GET /dashboard/configuracoes/ativos.
            A query filtra por usuario_id + ativo=true e ordena por ordem_exibicao,
            eliminando full-table scan e file-sort a cada requisição do dashboard.
        -->
        <createIndex indexName="idx_config_grafico_usuario_ativo_ordem"
                     tableName="configuracao_grafico_dashboard">
            <column name="usuario_id"/>
            <column name="ativo"/>
            <column name="ordem_exibicao"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
