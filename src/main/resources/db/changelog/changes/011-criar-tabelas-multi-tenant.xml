<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ========================================== -->
    <!-- TABELA: ORGANIZACAO (TENANT)               -->
    <!-- ========================================== -->
    <changeSet id="011-001-criar-tabela-organizacao" author="equipe-sentinela">
        <createTable tableName="organizacao">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="razao_social" type="VARCHAR(200)"/>
            <column name="cnpj" type="VARCHAR(18)">
                <constraints unique="true"/>
            </column>
            <column name="tipo" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(150)"/>
            <column name="telefone" type="VARCHAR(20)"/>
            <column name="logo_url" type="VARCHAR(500)"/>
            <column name="endereco_id" type="BIGINT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ATIVO"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        
        <addForeignKeyConstraint 
            baseTableName="organizacao" 
            baseColumnNames="endereco_id"
            constraintName="fk_organizacao_endereco"
            referencedTableName="endereco"
            referencedColumnNames="EndCodigo"/>
            
        <createIndex tableName="organizacao" indexName="idx_organizacao_cnpj">
            <column name="cnpj"/>
        </createIndex>
        
        <createIndex tableName="organizacao" indexName="idx_organizacao_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- TABELA: TIPO_PROFISSIONAL                  -->
    <!-- ========================================== -->
    <changeSet id="011-002-criar-tabela-tipo-profissional" author="equipe-sentinela">
        <createTable tableName="tipo_profissional">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="codigo" type="VARCHAR(20)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="conselho" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="TINYINT" defaultValue="1"/>
        </createTable>
        
        <createIndex tableName="tipo_profissional" indexName="idx_tipo_prof_codigo">
            <column name="codigo"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- TABELA: ESPECIALIDADE                      -->
    <!-- ========================================== -->
    <changeSet id="011-003-criar-tabela-especialidade" author="equipe-sentinela">
        <createTable tableName="especialidade">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tipo_profissional_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="codigo" type="VARCHAR(100)"/>
            <column name="status" type="TINYINT" defaultValue="1"/>
        </createTable>
        
        <addForeignKeyConstraint 
            baseTableName="especialidade" 
            baseColumnNames="tipo_profissional_id"
            constraintName="fk_especialidade_tipo_profissional"
            referencedTableName="tipo_profissional"
            referencedColumnNames="id"/>
            
        <addUniqueConstraint 
            tableName="especialidade"
            columnNames="tipo_profissional_id, nome"
            constraintName="uk_especialidade_tipo_nome"/>
            
        <createIndex tableName="especialidade" indexName="idx_especialidade_tipo_prof">
            <column name="tipo_profissional_id"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- TABELA: FORMA_PAGAMENTO                    -->
    <!-- ========================================== -->
    <changeSet id="011-004-criar-tabela-forma-pagamento" author="equipe-sentinela">
        <createTable tableName="forma_pagamento">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organizacao_id" type="BIGINT"/>
            <column name="nome" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="codigo" type="VARCHAR(20)"/>
            <column name="status" type="TINYINT" defaultValue="1"/>
        </createTable>
        
        <addForeignKeyConstraint 
            baseTableName="forma_pagamento" 
            baseColumnNames="organizacao_id"
            constraintName="fk_forma_pagamento_organizacao"
            referencedTableName="organizacao"
            referencedColumnNames="id"/>
            
        <createIndex tableName="forma_pagamento" indexName="idx_forma_pag_org">
            <column name="organizacao_id"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- TABELA: ADMIN_ORGANIZACAO                  -->
    <!-- ========================================== -->
    <changeSet id="011-005-criar-tabela-admin-organizacao" author="equipe-sentinela">
        <createTable tableName="admin_organizacao">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organizacao_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="cargo" type="VARCHAR(100)"/>
            <column name="email" type="VARCHAR(150)"/>
            <column name="is_owner" type="TINYINT" defaultValue="0"/>
            <column name="permissoes" type="JSON"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ATIVO"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        
        <addForeignKeyConstraint 
            baseTableName="admin_organizacao" 
            baseColumnNames="organizacao_id"
            constraintName="fk_admin_org_organizacao"
            referencedTableName="organizacao"
            referencedColumnNames="id"/>
            
        <addForeignKeyConstraint 
            baseTableName="admin_organizacao" 
            baseColumnNames="usuario_id"
            constraintName="fk_admin_org_usuario"
            referencedTableName="usuarios"
            referencedColumnNames="id"/>
            
        <addUniqueConstraint 
            tableName="admin_organizacao"
            columnNames="organizacao_id, usuario_id"
            constraintName="uk_admin_org"/>
            
        <createIndex tableName="admin_organizacao" indexName="idx_admin_org_organizacao">
            <column name="organizacao_id"/>
        </createIndex>
        
        <createIndex tableName="admin_organizacao" indexName="idx_admin_org_usuario">
            <column name="usuario_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
