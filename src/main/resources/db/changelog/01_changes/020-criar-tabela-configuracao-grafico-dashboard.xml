<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ================================================================ -->
    <!-- TABELA: CONFIGURACAO_GRAFICO_DASHBOARD                            -->
    <!-- Cada usuário tem suas próprias configurações de gráficos,         -->
    <!-- filtradas pelo perfil (GESTOR/ROOT vs CLINICO)      -->
    <!-- ================================================================ -->
    <changeSet id="020-001-criar-tabela-configuracao-grafico-dashboard" author="equipe-sentinela">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="configuracao_grafico_dashboard"/></not>
        </preConditions>

        <createTable tableName="configuracao_grafico_dashboard">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- nullable=true: SuperAdmin não tem organização -->
            <column name="organizacao_id" type="BIGINT"/>

            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="tipo_grafico" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="ordem_exibicao" type="INT"/>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <!-- FKs -->
        <addForeignKeyConstraint
                baseTableName="configuracao_grafico_dashboard"
                baseColumnNames="organizacao_id"
                constraintName="fk_config_grafico_organizacao"
                referencedTableName="organizacao"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="configuracao_grafico_dashboard"
                baseColumnNames="usuario_id"
                constraintName="fk_config_grafico_usuario"
                referencedTableName="usuarios"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <!-- Índices -->
        <createIndex tableName="configuracao_grafico_dashboard"
                     indexName="idx_config_grafico_usuario">
            <column name="usuario_id"/>
        </createIndex>

        <createIndex tableName="configuracao_grafico_dashboard"
                     indexName="idx_config_grafico_organizacao">
            <column name="organizacao_id"/>
        </createIndex>

        <createIndex tableName="configuracao_grafico_dashboard"
                     indexName="idx_config_grafico_tipo">
            <column name="tipo_grafico"/>
        </createIndex>

        <!-- Unique: cada usuário só pode ter uma config por tipo de gráfico -->
        <addUniqueConstraint
                tableName="configuracao_grafico_dashboard"
                columnNames="usuario_id, tipo_grafico"
                constraintName="uk_usuario_tipo_grafico"/>

    </changeSet>


</databaseChangeLog>