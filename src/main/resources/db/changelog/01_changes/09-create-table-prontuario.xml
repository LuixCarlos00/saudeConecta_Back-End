<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="010-create-table-prontuario" author="saudeConecta">
        <createTable tableName="prontuario">
            <column name="prontCodigoProntuario" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="prontPeso" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="prontAltura" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="prontTemperatura" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="prontSexo" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="prontSaturacao" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="prontHemoglobina" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="prontPressao" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="prontFrequenciaRespiratoria" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="prontFrequenciaArterialSistolica" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="prontFrequenciaArterialDiastolica" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="prontObservacao" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="prontCondulta" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="prontAnamnese" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="prontQueixaPricipal" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="prontDiagnostico" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="prontModeloPrescricao" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="prontTituloPrescricao" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="prontDataPrescricao" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="prontPrescricao" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="prontDataFinalizado" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="prontCodigoMedico" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="consulta" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="prontModeloExame" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="prontTituloExame" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="prontDataExame" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="prontExame" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="prontTempoDuracao" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="prontuario"
            baseColumnNames="prontCodigoMedico"
            referencedTableName="profissional"
            referencedColumnNames="id"
            constraintName="fk_prontuario_profissional"/>

        <addForeignKeyConstraint
            baseTableName="prontuario"
            baseColumnNames="consulta"
            referencedTableName="consulta"
            referencedColumnNames="id"
            constraintName="fk_prontuario_consulta"/>
    </changeSet>

</databaseChangeLog>
