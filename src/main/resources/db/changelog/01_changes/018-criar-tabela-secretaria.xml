<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="018-001-criar-tabela-secretaria" author="equipe-sentinela">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="secretaria"/></not>
        </preConditions>
        <createTable tableName="secretaria">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organizacao_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="nome" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="cpf" type="VARCHAR(14)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="telefone" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="ATIVO">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint 
            baseTableName="secretaria" 
            baseColumnNames="organizacao_id"
            constraintName="fk_secretaria_organizacao"
            referencedTableName="organizacao"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint 
            baseTableName="secretaria" 
            baseColumnNames="usuario_id"
            constraintName="fk_secretaria_usuario"
            referencedTableName="usuarios"
            referencedColumnNames="id"/>

        <createIndex tableName="secretaria" indexName="idx_secretaria_organizacao">
            <column name="organizacao_id"/>
        </createIndex>

        <createIndex tableName="secretaria" indexName="idx_secretaria_cpf">
            <column name="cpf"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
