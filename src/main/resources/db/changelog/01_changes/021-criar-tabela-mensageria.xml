<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="021-criar-tabela-mensageria" author="equipe-sentinela">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="mensageria"/></not>
        </preConditions>
        <createTable tableName="mensageria">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organizacao_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="destinatario_profissional_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="destinatario_email" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="destinatario_nome" type="VARCHAR(150)">
                <constraints nullable="true"/>
            </column>
            <column name="assunto" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="corpo_mensagem" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_mensagem" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDENTE">
                <constraints nullable="false"/>
            </column>
            <column name="erro_detalhe" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="tentativas" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="admin_notificado" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="data_criacao" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="data_atualizacao" type="DATETIME">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="mensageria"
                baseColumnNames="organizacao_id"
                constraintName="fk_mensageria_organizacao"
                referencedTableName="organizacao"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="mensageria"
                baseColumnNames="destinatario_profissional_id"
                constraintName="fk_mensageria_profissional"
                referencedTableName="profissional"
                referencedColumnNames="id"/>

        <createIndex tableName="mensageria" indexName="idx_mensageria_organizacao">
            <column name="organizacao_id"/>
        </createIndex>

        <createIndex tableName="mensageria" indexName="idx_mensageria_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="mensageria" indexName="idx_mensageria_profissional">
            <column name="destinatario_profissional_id"/>
        </createIndex>

        <createIndex tableName="mensageria" indexName="idx_mensageria_data_criacao">
            <column name="data_criacao"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>