<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="022-create-historico-dados-pessoais" author="luiz">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="historico_dados_pessoais"/></not>
        </preConditions>

        <createTable tableName="historico_dados_pessoais">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organizacao_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="entidade" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="id_entidade" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="campo" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="valor_anterior" type="TEXT"/>
            <column name="valor_novo" type="TEXT"/>
            <column name="criado_em" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="historico_dados_pessoais"
                     indexName="idx_historico_org_entidade_id">
            <column name="organizacao_id"/>
            <column name="entidade"/>
            <column name="id_entidade"/>
        </createIndex>

        <createIndex tableName="historico_dados_pessoais"
                     indexName="idx_historico_usuario">
            <column name="organizacao_id"/>
            <column name="usuario_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>