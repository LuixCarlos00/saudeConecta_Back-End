<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ========================================== -->
    <!-- TABELA: PLANO_ASSINATURA                   -->
    <!-- Define os planos disponíveis no sistema.   -->
    <!-- Limites NULL = ilimitado.                   -->
    <!-- ========================================== -->
    <changeSet id="027-001-criar-tabela-plano-assinatura" author="equipe-sentinela">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="plano_assinatura"/></not>
        </preConditions>
        <createTable tableName="plano_assinatura">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="descricao" type="VARCHAR(255)"/>
            <column name="tipo" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="valor_mensal" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="limite_admin_org" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="limite_profissional" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="limite_secretaria" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="ativo" type="TINYINT(1)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="criado_em" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="atualizado_em" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint
            tableName="plano_assinatura"
            columnNames="tipo"
            constraintName="uk_plano_tipo"/>

        <createIndex tableName="plano_assinatura" indexName="idx_plano_ativo">
            <column name="ativo"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- TABELA: ASSINATURA_TENANT                  -->
    <!-- Vincula uma organização (tenant) a um      -->
    <!-- plano e controla o ciclo de vida.           -->
    <!-- ========================================== -->
    <changeSet id="027-002-criar-tabela-assinatura-tenant" author="equipe-sentinela">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="assinatura_tenant"/></not>
        </preConditions>
        <createTable tableName="assinatura_tenant">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organizacao_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="plano_assinatura_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="TRIAL">
                <constraints nullable="false"/>
            </column>
            <column name="data_inicio" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="data_vencimento" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="data_proxima_cobranca" type="DATE"/>
            <column name="valor_mensal" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="criado_em" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="atualizado_em" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="assinatura_tenant"
            baseColumnNames="organizacao_id"
            constraintName="fk_assinatura_organizacao"
            referencedTableName="organizacao"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="assinatura_tenant"
            baseColumnNames="plano_assinatura_id"
            constraintName="fk_assinatura_plano"
            referencedTableName="plano_assinatura"
            referencedColumnNames="id"/>

        <createIndex tableName="assinatura_tenant" indexName="idx_assinatura_org">
            <column name="organizacao_id"/>
        </createIndex>

        <createIndex tableName="assinatura_tenant" indexName="idx_assinatura_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="assinatura_tenant" indexName="idx_assinatura_vencimento">
            <column name="data_vencimento"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- TABELA: COBRANCA_TENANT                    -->
    <!-- Registra cada cobrança gerada para um      -->
    <!-- tenant, com dados Pix para pagamento.       -->
    <!-- ========================================== -->
    <changeSet id="027-003-criar-tabela-cobranca-tenant" author="equipe-sentinela">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="cobranca_tenant"/></not>
        </preConditions>
        <createTable tableName="cobranca_tenant">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="assinatura_tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="organizacao_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="valor_total" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDENTE">
                <constraints nullable="false"/>
            </column>
            <column name="pix_copia_cola" type="TEXT"/>
            <column name="pix_qrcode_base64" type="LONGTEXT"/>
            <column name="txid" type="VARCHAR(100)">
                <constraints unique="true"/>
            </column>
            <column name="data_vencimento_pix" type="DATE"/>
            <column name="data_pagamento" type="TIMESTAMP"/>
            <column name="criada_em" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="cobranca_tenant"
            baseColumnNames="assinatura_tenant_id"
            constraintName="fk_cobranca_assinatura"
            referencedTableName="assinatura_tenant"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="cobranca_tenant"
            baseColumnNames="organizacao_id"
            constraintName="fk_cobranca_organizacao"
            referencedTableName="organizacao"
            referencedColumnNames="id"/>

        <createIndex tableName="cobranca_tenant" indexName="idx_cobranca_assinatura">
            <column name="assinatura_tenant_id"/>
        </createIndex>

        <createIndex tableName="cobranca_tenant" indexName="idx_cobranca_org">
            <column name="organizacao_id"/>
        </createIndex>

        <createIndex tableName="cobranca_tenant" indexName="idx_cobranca_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="cobranca_tenant" indexName="idx_cobranca_txid">
            <column name="txid"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- DADOS INICIAIS: 3 PLANOS PADRÃO            -->
    <!-- Starter (249), Profissional (449),          -->
    <!-- Business (699)                              -->
    <!-- ========================================== -->
    <changeSet id="027-004-inserir-planos-padrao" author="equipe-sentinela">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM plano_assinatura WHERE tipo IN ('STARTER','PROFISSIONAL','BUSINESS')</sqlCheck>
        </preConditions>
        <insert tableName="plano_assinatura">
            <column name="nome" value="Starter"/>
            <column name="descricao" value="Ideal para consultórios e profissionais autônomos"/>
            <column name="tipo" value="STARTER"/>
            <column name="valor_mensal" valueNumeric="249.00"/>
            <column name="limite_admin_org" valueNumeric="1"/>
            <column name="limite_profissional" valueNumeric="2"/>
            <column name="limite_secretaria" valueNumeric="1"/>
            <column name="ativo" valueNumeric="1"/>
        </insert>

        <insert tableName="plano_assinatura">
            <column name="nome" value="Profissional"/>
            <column name="descricao" value="Perfeito para clínicas em crescimento"/>
            <column name="tipo" value="PROFISSIONAL"/>
            <column name="valor_mensal" valueNumeric="449.00"/>
            <column name="limite_admin_org" valueNumeric="2"/>
            <column name="limite_profissional" valueNumeric="8"/>
            <column name="limite_secretaria" valueNumeric="4"/>
            <column name="ativo" valueNumeric="1"/>
        </insert>

        <insert tableName="plano_assinatura">
            <column name="nome" value="Business"/>
            <column name="descricao" value="Para clínicas de médio e grande porte"/>
            <column name="tipo" value="BUSINESS"/>
            <column name="valor_mensal" valueNumeric="699.00"/>
            <column name="limite_admin_org" valueNumeric="5"/>
            <column name="limite_profissional"/>
            <column name="limite_secretaria"/>
            <column name="ativo" valueNumeric="1"/>
        </insert>
    </changeSet>

</databaseChangeLog>
