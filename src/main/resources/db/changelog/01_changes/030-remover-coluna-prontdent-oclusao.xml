<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="030-remover-coluna-prontdent-oclusao" author="luiz.carlos">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="prontuario_dentista" columnName="prontdent_oclusao"/>
        </preConditions>
        <comment>Remove coluna duplicada prontdent_oclusao, mantendo apenas prontdent_oclusal</comment>
        <dropColumn tableName="prontuario_dentista" columnName="prontdent_oclusao"/>
    </changeSet>

</databaseChangeLog>
