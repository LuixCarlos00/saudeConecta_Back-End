<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009-create-table-secretaria" author="saudeConecta">
        <createTable tableName="secretaria">
            <column name="SecreCodigo" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="SecreNome" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="SecreStatus" type="TINYINT">
                <constraints nullable="true"/>
            </column>
            <column name="SecreDataCriacao" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="SecreEmail" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="SecreCodigoAtorizacao" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="SecreUsuario" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="secretaria"
            baseColumnNames="SecreUsuario"
            referencedTableName="usuarios"
            referencedColumnNames="id"
            constraintName="fk_secretaria_usuario"/>
    </changeSet>

</databaseChangeLog>
