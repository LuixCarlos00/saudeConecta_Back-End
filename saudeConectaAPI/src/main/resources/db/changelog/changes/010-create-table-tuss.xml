<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="011-create-table-tuss" author="sistema">
        <createTable tableName="tuss">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="codigo" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="descricao" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="tabela" type="VARCHAR(50)"/>
            <column name="grupo" type="VARCHAR(100)"/>
        </createTable>

        <createIndex tableName="tuss" indexName="idx_tuss_codigo">
            <column name="codigo"/>
        </createIndex>

        <createIndex tableName="tuss" indexName="idx_tuss_descricao">
            <column name="descricao"/>
        </createIndex>
    </changeSet>

