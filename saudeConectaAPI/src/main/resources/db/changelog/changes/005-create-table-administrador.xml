<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-create-table-administrador" author="saudeConecta">
        <createTable tableName="administrador">
            <column name="AdmCodigo" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="AdmNome" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="AdmStatus" type="TINYINT">
                <constraints nullable="true"/>
            </column>
            <column name="AdmDataCriacao" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="AdmEmail" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="AdmCodigoAtorizacao" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="AdmUsuario" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="administrador"
            baseColumnNames="AdmUsuario"
            referencedTableName="usuarios"
            referencedColumnNames="id"
            constraintName="fk_administrador_usuario"/>
    </changeSet>

</databaseChangeLog>
