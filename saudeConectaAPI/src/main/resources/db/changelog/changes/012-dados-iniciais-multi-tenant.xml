    <!-- ========================================== -->
    <!-- TIPOS DE PROFISSIONAL                      -->
    <!-- ========================================== -->
    <changeSet id="012-001-inserir-tipos-profissional" author="equipe-sentinela">
        <insert tableName="tipo_profissional">
            <column name="codigo" value="MEDICO"/>
            <column name="nome" value="Médico"/>
            <column name="conselho" value="CRM"/>
        </insert>
        <insert tableName="tipo_profissional">
            <column name="codigo" value="DENTISTA"/>
            <column name="nome" value="Cirurgião-Dentista"/>
            <column name="conselho" value="CRO"/>
        </insert>
        <insert tableName="tipo_profissional">
            <column name="codigo" value="FISIOTERAPEUTA"/>
