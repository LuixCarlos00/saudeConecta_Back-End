<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-table-medico" author="saudeConecta">
        <createTable tableName="medico">
            <column name="MedCodigo" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="MedNome" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="MedSexo" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="MedDataNacimento" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="MedCrm" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="MedCpf" type="VARCHAR(14)">
                <constraints nullable="true"/>
            </column>
            <column name="MedRg" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="MedEmail" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="MedTelefone" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="MedEspecialidade" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="MedFormacoes" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="MedEmpresa" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="MedGraduacao" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="Usuario" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="Endereco" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="MedTempoDeConsulta" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="medico"
            baseColumnNames="Usuario"
            referencedTableName="usuarios"
            referencedColumnNames="id"
            constraintName="fk_medico_usuario"/>

        <addForeignKeyConstraint
            baseTableName="medico"
            baseColumnNames="Endereco"
            referencedTableName="endereco"
            referencedColumnNames="EndCodigo"
            constraintName="fk_medico_endereco"/>
    </changeSet>

</databaseChangeLog>
