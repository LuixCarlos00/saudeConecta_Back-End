<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.0.5</version>
		<relativePath/>
	</parent>
	<groupId>com.example</groupId>
	<artifactId>demo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>demo</name>
	<description>Demo project for Spring Boot</description>
	<properties>
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.30</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Regras de dependência entre camadas (ArquiteturaTest); só teste, sem efeito em runtime -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.3.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.0.2-1</version>
            <scope>compile</scope>
        </dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.auth0</groupId>
			<artifactId>java-jwt</artifactId>
			<version>4.2.1</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
			<version>3.0.5</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-thymeleaf -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
			<version>3.0.5</version>
		</dependency>

		<!-- Liquibase para gerenciamento de migrações de banco de dados -->
		<dependency>
			<groupId>org.liquibase</groupId>
			<artifactId>liquibase-core</artifactId>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<!--
				Testes rodam no mesmo fuso da produção (Dockerfile: TZ e -Duser.timezone = America/Sao_Paulo).
				Sem isso, na CI (UTC) os testes que calculam "hoje" pelo fuso do sistema divergem do Clock
				da aplicação depois das 21h de Brasília. Vai por variável de ambiente para não disputar o
				argLine com o agente do JaCoCo.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<environmentVariables>
						<TZ>America/Sao_Paulo</TZ>
					</environmentVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.11</version>
				<configuration>
					<excludes>
						<!-- DTOs (records sem lógica) -->
						<exclude>br/com/saudeConecta/application/*/dto/**/*</exclude>
						<!-- Domain entities, enums e converters -->
						<exclude>br/com/saudeConecta/domain/**/*</exclude>
						<!-- Configurações Spring -->
						<!-- config/ é excluído por subpacote: MascaraLog e InputSanitizer têm lógica e teste, e são medidos -->
						<!-- raiz de config/ classe a classe: "config/*" no agente vira "config.*" e pegaria os subpacotes -->
						<exclude>br/com/saudeConecta/config/AsyncConfig*</exclude>
						<exclude>br/com/saudeConecta/config/CacheConfig*</exclude>
						<exclude>br/com/saudeConecta/config/FusoHorarioConfig*</exclude>
						<exclude>br/com/saudeConecta/config/RestTemplateConfig*</exclude>
						<exclude>br/com/saudeConecta/config/security/**/*</exclude>
						<exclude>br/com/saudeConecta/config/tenant/**/*</exclude>
						<exclude>br/com/saudeConecta/config/logging/CorrelationIdFilter*</exclude>
						<exclude>br/com/saudeConecta/config/logging/MdcChaves*</exclude>
						<exclude>br/com/saudeConecta/config/logging/MdcTaskDecorator*</exclude>
						<exclude>br/com/saudeConecta/config/logging/ScheduledMdcAspect*</exclude>
						<exclude>br/com/saudeConecta/config/web/RateLimiter*</exclude>
						<exclude>br/com/saudeConecta/config/web/LimiteCorpoRascunhoFilter*</exclude>
						<exclude>br/com/saudeConecta/config/web/SafeInput*</exclude>
						<!-- Infraestrutura: repositórios JPA, tenant, filtros -->
						<!-- (ex-infra/exceptions: exceções e handler HTTP, excluídos como antes da B5) -->
						<exclude>br/com/saudeConecta/application/exception/**/*</exclude>
						<exclude>br/com/saudeConecta/presentation/erro/**/*</exclude>
						<exclude>br/com/saudeConecta/infrastructure/**/*</exclude>
						<!-- Infraestrutura de email: depende de SMTP/Thymeleaf reais -->
						<exclude>br/com/saudeConecta/infrastructure/email/EmailRemetenteService*</exclude>
						<exclude>br/com/saudeConecta/infrastructure/email/EmailRetryService*</exclude>
						<exclude>br/com/saudeConecta/infrastructure/email/EmailTemplateService*</exclude>
						<exclude>br/com/saudeConecta/application/notificacao/EmailMensageriaService*</exclude>
						<exclude>br/com/saudeConecta/infrastructure/email/EmailConfig*</exclude>
						<!-- Gateway de pagamento Mercado Pago (integração externa) -->
						<exclude>br/com/saudeConecta/infrastructure/mercadopago/MercadoPagoClient*</exclude>
						<exclude>br/com/saudeConecta/infrastructure/mercadopago/MercadoPagoProperties*</exclude>
						<!-- Utilitários com dependências de repositório/infraestrutura -->
						<exclude>br/com/saudeConecta/application/usuario/EmailUnicoService*</exclude>
						<exclude>br/com/saudeConecta/application/historico/SnapshotUtil*</exclude>
						<!-- Controllers: cobertos por testes de integração (MockMvc não gera cobertura de instrução JaCoCo) -->
						<exclude>br/com/saudeConecta/presentation/controller/**/*</exclude>
						<!-- Services de IA (requer modelo externo) -->
						<exclude>br/com/saudeConecta/application/atendimento/IALocalService*</exclude>
						<!-- Services de cobrança/financeiro (integração com gateway externo) -->
						<exclude>br/com/saudeConecta/application/cobranca/CobrancaService*</exclude>
						<exclude>br/com/saudeConecta/application/cobranca/CobrancaScheduler*</exclude>
						<!-- Services de dashboard (configuraçōes visuais, sem lógica de negócio crítica) -->
						<exclude>br/com/saudeConecta/application/dashboard/ConfiguracaoGraficoDashboardService*</exclude>
						<exclude>br/com/saudeConecta/application/dashboard/ConfiguracaoCardDashboardService*</exclude>
						<!-- Services de histórico e planejamento (dependem de queries complexas sem lógica de negócio) -->
						<exclude>br/com/saudeConecta/application/historico/HistoricoDadosPessoaisService*</exclude>
						<exclude>br/com/saudeConecta/application/prontuario/PlanejamentoTerapeuticoService*</exclude>
						<exclude>br/com/saudeConecta/application/prontuario/TermoAutorizacaoService*</exclude>
						<exclude>br/com/saudeConecta/application/prontuario/ProcedimentoPadraoService*</exclude>
						<!-- Classe principal da aplicação -->
						<exclude>br/com/saudeConecta/SaudeConectaApplication*</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
